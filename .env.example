# Copy to .env (for `npm run build` / the desktop shortcut) and fill in. On Vercel, add the same names under
# Project → Settings → Environment Variables. Without these keys the app runs local-only, as before.
# Step-by-step guide: docs/SUPABASE.md

# Supabase → Project Settings → API → Project URL (just https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase → Project Settings → API → anon public key (safe in the browser; row-level security protects the data)
VITE_SUPABASE_ANON_KEY=
# The public site address. The desktop app sends confirmation and reset links here.
VITE_SITE_URL=https://cbersecurity-learning-platform.vercel.app/
