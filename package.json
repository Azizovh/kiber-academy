{
  "name": "kiberakademiya",
  "private": true,
  "version": "1.23.0",
  "description": "Kiberxavfsizlikni noldan professional darajagacha o'rgatuvchi o'quv dasturi",
  "author": "KiberAkademiya",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-runtimes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-runtimes.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.119.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.460.0",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.17.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "uz.kiberakademiya.app",
    "productName": "KiberAkademiya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "KiberAkademiya-${version}.exe"
    }
  }
}
